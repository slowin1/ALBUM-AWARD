datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Пользователь
model User {
  id            String       @id @default(uuid())
  nickname      String       @unique
  email         String       @unique
  passwordHash  String?
  provider      String?      @default("local") // 'local' | 'telegram' | 'google' | 'apple'
  role          String       @default("user")  // 'user' | 'admin'
  bio           String?      @db.Text
  favoriteGenre String?
  avatarUrl     String?
  avatarSymbol  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  preferences   Preference?
  reviews       Review[]
  votes         Vote[]
  likes         ReviewLike[]
}

// 2. Топ-5 предпочтений пользователя в профиле
model Preference {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JSON массивы Топ-5 для каждой категории
  artists       Json?        // [{ id, name, cover, note }]
  albums        Json?
  tracks        Json?
  producers     Json?
  clipmakers    Json?
  designers     Json?
  soundengineers Json?

  updatedAt     DateTime     @updatedAt
}

// 3. Артист / Саунд-продюсер
model Artist {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique
  avatar         String
  bio            String?      @db.Text
  genres         String[]     @default([])

  // Саунд-продакшн (битмейкер / продюсер)
  isProducer     Boolean      @default(false)
  producerTag    String?      // Например: "Metro Boomin want some more" или "Aarne, piece of shit"

  // Фрешмены и сезонные награды
  isFreshman     Boolean      @default(false)
  freshmanYear   Int?
  breakoutTitle  String?
  monthAward     String?      // e.g. "Сезон 2026"
  isNominee      Boolean      @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Связи
  albums         Album[]      @relation("AlbumArtists")
  producedAlbums Album[]      @relation("AlbumProducers")
  tracks         Track[]      @relation("TrackArtists")   // Треки, где артист у микрофона (фиты и сольные)
  producedTracks Track[]      @relation("TrackProducers") // Треки, где артист написал бит / саунд-продюсер
  freshman       Freshman?
  slots          SceneSlot[]

  @@index([slug])
  @@index([name])
}

// 4. Альбом
model Album {
  id                   String   @id @default(uuid())
  title                String
  slug                 String   @unique
  year                 Int?
  cover                String
  description          String?  @db.Text

  // SoundCloud / стриминг
  soundcloudUrl        String?
  soundcloudPlaylistId String?
  sourceUrl            String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Связи
  artistId             String?
  artist               Artist?  @relation("AlbumArtists", fields: [artistId], references: [id], onDelete: SetNull)
  producers            Artist[] @relation("AlbumProducers") // Продюсеры альбома

  tracks               Track[]
  reviews              Review[]
  slots                SceneSlot[]

  @@index([slug])
  @@index([title])
  @@index([artistId])
}

// 5. Трек
model Track {
  id                String   @id @default(uuid())
  title             String
  duration          String?
  cover             String
  artistDisplay     String?  // e.g. "163ONMYNECK feat. OG Buda"
  audioUrl          String?
  soundcloudUrl     String?
  soundcloudTrackId String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Связи
  albumId           String?
  album             Album?   @relation(fields: [albumId], references: [id], onDelete: Cascade)

  artists           Artist[] @relation("TrackArtists")   // У микрофона (сольные и фиты)
  producers         Artist[] @relation("TrackProducers") // Саунд-продюсеры (биты / продакшн)
  reviews           Review[]
  lyrics            Lyrics?
  slots             SceneSlot[]

  @@index([title])
  @@index([albumId])
}

// 6. Фрешмен года / номинация
model Freshman {
  id         String   @id @default(uuid())
  year       Int      @default(2026)
  tag        String?  // Например: "Прорыв года"
  order      Int      @default(0)
  votesCount Int      @default(0)

  // Связь с артистом
  artistId   String   @unique
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
}

// 7. Рецензия
model Review {
  id                 String   @id @default(uuid())

  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  albumId            String?
  album              Album?   @relation(fields: [albumId], references: [id], onDelete: Cascade)

  trackId            String?
  track              Track?   @relation(fields: [trackId], references: [id], onDelete: Cascade)

  // Текст рецензии
  title              String?
  text               String?  @db.Text

  // Оценки по критериям (0-10)
  rhymesScore        Int?     @default(0)
  structureScore     Int?     @default(0)
  styleScore         Int?     @default(0)
  individualityScore Int?     @default(0)
  atmosphereScore    Int?     @default(0)

  multiplier         Int?     @default(1)
  totalScore         Float    @default(0)

  likesCount         Int      @default(0)
  likes              ReviewLike[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, albumId])
  @@index([userId])
  @@index([albumId])
  @@index([trackId])
}

// 8. Голосование (артист месяца / альбом года)
model Vote {
  id         String   @id @default(uuid())
  category   String   // 'album_of_the_year' | 'month_artist'
  targetId   String   // ID альбома или артиста, за которого проголосовали
  season     String   @default("2026")

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, category, season])
}

// 9. Слоты 3D-сцены
model SceneSlot {
  id          String   @id @default(uuid())
  type        String   // 'artist' | 'album' | 'track'
  slotIndex   Int      // 0..11

  artistId    String?
  artist      Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)

  albumId     String?
  album       Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)

  trackId     String?
  track       Track?   @relation(fields: [trackId], references: [id], onDelete: SetNull)

  customTitle String?
  customCover String?

  updatedAt   DateTime @updatedAt

  @@unique([type, slotIndex])
}

// 10. Тексты песен и караоке
model Lyrics {
  id        String   @id @default(uuid())
  artist    String
  title     String
  synced    String?  @db.Text
  plain     String?  @db.Text
  source    String   @default("lrclib") // 'lrclib' | 'genius' | 'manual'

  trackId   String?  @unique
  track     Track?   @relation(fields: [trackId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([artist, title])
  @@index([artist, title])
}

// 11. Лайк на рецензию
model ReviewLike {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
}
